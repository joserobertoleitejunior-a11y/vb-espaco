/*
  # frame-ancestors 'self': o próprio site pode se abrir numa janelinha interna
  # (o painel de pedidos dentro do painel, a prévia do editor), e nenhum outro
  # site consegue. O X-Frame-Options fica junto pros navegadores antigos.
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: frame-ancestors 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# arquivos com ?v= mudam de nome a cada versão; os outros (fotos prontas,
# ícones) se renovam em até um dia
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
